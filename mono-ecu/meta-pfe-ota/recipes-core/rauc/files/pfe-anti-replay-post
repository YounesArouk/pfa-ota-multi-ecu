#!/bin/sh

STATE_DIR="/data/rauc/accepted-releases"
RELEASE_ID="${RAUC_META_PFE_RELEASE_ID:-}"
TRANSACTION_ID="${RAUC_TRANSACTION_ID:-unknown}"

if [ -z "$RELEASE_ID" ]; then
    echo "<< error Anti-replay: identifiant release-id absent apres installation"
    exit 1
fi

case "$RELEASE_ID" in
    *[!A-Za-z0-9._-]*)
        echo "<< error Anti-replay: identifiant release-id invalide"
        exit 1
        ;;
esac

mkdir -p "$STATE_DIR" || {
    echo "<< error Anti-replay: impossible de preparer le registre"
    exit 1
}

MARKER="$STATE_DIR/$RELEASE_ID"
TMP_MARKER="$STATE_DIR/.${RELEASE_ID}.$$"

umask 077

{
    printf 'release-id=%s\n' "$RELEASE_ID"
    printf 'transaction-id=%s\n' "$TRANSACTION_ID"
} > "$TMP_MARKER" || {
    echo "<< error Anti-replay: impossible de creer le marqueur"
    exit 1
}

mv "$TMP_MARKER" "$MARKER" || {
    rm -f "$TMP_MARKER"
    echo "<< error Anti-replay: impossible d enregistrer le marqueur"
    exit 1
}

sync
echo "<< handler anti-replay-recorded"
exit 0
