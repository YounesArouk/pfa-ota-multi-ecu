#!/bin/sh

### BEGIN INIT INFO
# Provides:          pfe-healthcheck
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PFE OTA automatic health check
### END INIT INFO

case "${1:-}" in
    start)
        echo "Starting PFE OTA health check..."
        /usr/bin/pfe-healthcheck
        exit $?
        ;;

    stop)
        # Le controle est de type oneshot : aucun processus permanent.
        exit 0
        ;;

    restart|force-reload)
        "$0" start
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|force-reload}"
        exit 1
        ;;
esac
